# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/

# Local env / secrets
.env
.env.*

# Scratch / analysis working dirs (live outside the repo too)
_analysis/

# Tooling caches
.pytest_cache/
.ruff_cache/

# OS
Thumbs.db
.DS_Store

# Office/WPS lock files
~$*

# ---- Project workspaces -------------------------------------------------
# projects/ ships only the curated demo project (see projects/README.md).
# Everything else is a user workspace and stays local.
projects/*
!projects/README.md
!projects/_demo/

# Build artifacts are never committed: they are large, binary and
# regenerated by `docx_builder.py build`.
projects/_demo/exports/*.docx
projects/*/exports/*.docx
projects/*/sources/*
!projects/*/sources/.gitkeep
